# ==============================================================================
# Environment Configuration Template (.env.example)
# ==============================================================================
# Salin file ini menjadi `.env.local` untuk development lokal:
#   cp .env.example .env.local
#
# JANGAN PERNAH meng-commit file `.env.local` atau memasukkan secret asli ke Git!
# ==============================================================================

# Supabase Configuration
# NEXT_PUBLIC_* aman diakses di client browser (hanya untuk operasi public read yang dilindungi RLS)
NEXT_PUBLIC_SUPABASE_URL=https://your-project-id.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=your-supabase-anon-publishable-key

# Supabase Server-Only Secret (OPSIONAL / SANGAT DIREKOMENDASIKAN)
# Kunci ini HANYA boleh ada di server (tanpa NEXT_PUBLIC_), digunakan untuk bypass RLS saat admin menyimpan data.
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-secret-key

# Cloudflare R2 Credentials (Server-only S3 API)
CLOUDFLARE_R2_ACCOUNT_ID=your-cloudflare-account-id
CLOUDFLARE_R2_ACCESS_KEY_ID=your-r2-access-key-id
CLOUDFLARE_R2_SECRET_ACCESS_KEY=your-r2-secret-access-key
CLOUDFLARE_R2_BUCKET_NAME=portfolio
NEXT_PUBLIC_CLOUDFLARE_R2_PUBLIC_URL=https://media.yourdomain.tech

# Secret Admin Route Path (URL obfuscation untuk portal admin)
NEXT_PUBLIC_ADMIN_SECRET_PATH=mna-system-control-secret

# Admin Security Credentials (Server-only)
ADMIN_MASTER_PIN=your-secure-admin-pin
SESSION_SECRET=your-cryptographically-random-session-secret-min-32-chars

# Google reCAPTCHA v2 (Checkbox)
NEXT_PUBLIC_RECAPTCHA_SITE_KEY=your-recaptcha-v2-site-key
RECAPTCHA_SECRET_KEY=your-recaptcha-v2-secret-key

# Google Analytics (Opsional)
NEXT_PUBLIC_GA_ID=G-XXXXXXXXXX
